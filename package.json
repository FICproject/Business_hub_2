{
  "name": "business-hub-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Business Hub - All-in-one digital platform for Marketplace, Education, Jobs, and Business Management",
  "workspaces": [
    "backend",
    "users-website",
    "admin-website",
    "user-mobile",
    "admin-mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:users\" \"npm run dev:admin\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:users": "cd users-website && npm run dev",
    "dev:admin": "cd admin-website && npm run dev",
    "build": "npm run build --workspaces",
    "seed": "cd backend && npm run seed",
    "test": "cd backend && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
