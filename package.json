{
  "name": "business-hub-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Business Hub - All-in-one digital platform for Marketplace, Education, Jobs, and Business Management",
  "workspaces": [
    "backend",
    "user-website",
    "admin-website",
    "user-mobile",
    "admin-mobile"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:user\" \"npm run dev:admin\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:user": "cd user-website && npm run dev",
    "dev:admin": "cd admin-website && npm run dev",
    "build": "npm run build --prefix user-website",
    "build:user": "npm run build --prefix user-website",
    "build:admin": "npm run build --prefix admin-website",
    "build:all": "npm run build --workspaces --if-present",
    "seed": "cd backend && npm run seed",
    "test": "cd backend && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
