# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/business_hub
# Fallback in-memory database is automatically activated when MongoDB is not running locally

# Security & Authentication
JWT_SECRET=business_hub_super_secure_jwt_secret_key_2026_xyz!
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=business_hub_refresh_token_secret_2026_xyz!
COOKIE_SECRET=business_hub_cookie_secret_998877

# Cloudinary Storage (Optional for external media)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email & SMS OTP Service Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
SMS_API_KEY=mock_sms_api_key

# Payment Gateway Configuration (Stripe / Razorpay Pluggable)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook
PAYMENT_IDEMPOTENCY_WINDOW_SECONDS=300
